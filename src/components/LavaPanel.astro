---
/**
 * WebGL metaball "lava lamp" background, ported from archboard-billing's LavaPanel.vue.
 * Renders behind its slot. Colors are any CSS color strings; the panel's own background
 * (set via `class`) shows wherever the lava isn't.
 */
interface Props {
  colors: string[]
  speed?: number
  class?: string
  as?: string
}

const { colors, speed = 0.5, class: className, as: Tag = 'div' } = Astro.props
---

<Tag class:list={['relative isolate overflow-hidden', className]} data-lava={JSON.stringify(colors)} data-lava-speed={speed}>
  <canvas aria-hidden="true" class="absolute inset-0 -z-10 size-full"></canvas>
  <slot />
</Tag>

<script>
  const MAX_BLOBS = 12
  // Blobs are soft, so half the device resolution is invisible and quarters the GPU work.
  const RENDER_SCALE = 0.5

  const vertexShader = `
attribute vec2 position;
void main() { gl_Position = vec4(position, 0.0, 1.0); }
`

  /** Metaballs: every blob adds a smooth bump that fades to zero at 2.2r, colors blend by each blob's share, and the field becomes alpha. */
  const fragmentShader = `
precision highp float;
uniform vec2 resolution;
uniform float time;
uniform int count;
uniform vec3 colors[${MAX_BLOBS}];
uniform vec3 pointer;

float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main() {
  float aspect = resolution.x / resolution.y;
  vec2 p = (gl_FragCoord.xy - 0.5 * resolution) / resolution.y;
  p += 0.06 * vec2(sin(p.y * 3.0 + time * 0.5), sin(p.x * 3.0 - time * 0.4));

  float field = 0.0;
  vec3 color = vec3(0.0);
  for (int i = 0; i < ${MAX_BLOBS}; i++) {
    if (i >= count) break;
    float f = float(i);
    float lane = (f + 0.5) / float(count) - 0.5;
    vec2 center = vec2(
      lane * aspect * 0.9 + 0.12 * sin(time * 0.21 + f * 2.4),
      0.55 * sin(time * (0.09 + 0.017 * f) + f * 1.9)
    );
    float radius = 0.18 + 0.04 * sin(time * 0.3 + f * 1.3);
    vec2 d = p - center;
    float falloff = max(0.0, 1.0 - dot(d, d) / (4.84 * radius * radius));
    float weight = 1.6 * falloff * falloff;
    field += weight;
    color += colors[i] * weight;
  }

  vec2 d = p - pointer.xy;
  float falloff = max(0.0, 1.0 - dot(d, d) / 0.06);
  float weight = pointer.z * 1.2 * falloff * falloff;
  field += weight;
  color += colors[0] * weight;

  color /= max(field, 0.0001);
  float alpha = smoothstep(0.2, 1.4, field);
  color += (hash(gl_FragCoord.xy + fract(time)) - 0.5) * 0.06;
  gl_FragColor = vec4(color * alpha, alpha);
}
`

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

  /** Resolves any CSS color to sRGB 0–1 by letting a 2D canvas parse it. */
  function toRgb(context: CanvasRenderingContext2D, value: string): [number, number, number] {
    context.clearRect(0, 0, 1, 1)
    context.fillStyle = value
    context.fillRect(0, 0, 1, 1)
    const [r, g, b] = context.getImageData(0, 0, 1, 1).data
    return [r / 255, g / 255, b / 255]
  }

  /** Chrome masks RENDERER as 'WebKit WebGL'; software renderers tie up the main thread, so they get one still frame. */
  function isSoftwareRendered(gl: WebGLRenderingContext): boolean {
    let renderer: string = gl.getParameter(gl.RENDERER)
    if (renderer === 'WebKit WebGL') {
      const debugInfo = gl.getExtension('WEBGL_debug_renderer_info')
      renderer = debugInfo ? gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL) : renderer
    }
    return /swiftshader|llvmpipe|software/i.test(renderer)
  }

  function compile(gl: WebGLRenderingContext, type: number, source: string): WebGLShader {
    const shader = gl.createShader(type)!
    gl.shaderSource(shader, source)
    gl.compileShader(shader)
    return shader
  }

  function mount(root: HTMLElement): void {
    const canvas = root.querySelector<HTMLCanvasElement>(':scope > canvas')
    const gl = canvas?.getContext('webgl', { antialias: false, depth: false })
    if (!canvas || !gl) {
      return
    }
    const still = reducedMotion || isSoftwareRendered(gl)
    const speed = Number(root.dataset.lavaSpeed ?? 0.5)

    const program = gl.createProgram()!
    gl.attachShader(program, compile(gl, gl.VERTEX_SHADER, vertexShader))
    gl.attachShader(program, compile(gl, gl.FRAGMENT_SHADER, fragmentShader))
    gl.bindAttribLocation(program, 0, 'position')
    gl.linkProgram(program)
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error(gl.getProgramInfoLog(program))
      return
    }
    gl.useProgram(program)

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer())
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW)
    gl.enableVertexAttribArray(0)
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0)

    const u = {
      resolution: gl.getUniformLocation(program, 'resolution'),
      time: gl.getUniformLocation(program, 'time'),
      count: gl.getUniformLocation(program, 'count'),
      colors: gl.getUniformLocation(program, 'colors'),
      pointer: gl.getUniformLocation(program, 'pointer'),
    }

    const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!
    const rgb = (JSON.parse(root.dataset.lava ?? '[]') as string[]).map((c) => toRgb(probe, c))
    const count = Math.min(MAX_BLOBS, Math.max(6, rgb.length * 2))
    const blobColors = new Float32Array(MAX_BLOBS * 3)
    for (let i = 0; i < count; i++) {
      blobColors.set(rgb[i % rgb.length], i * 3)
    }
    gl.uniform1i(u.count, count)
    gl.uniform3fv(u.colors, blobColors)

    const pointer = { x: 0, y: 0, z: 0, targetX: 0, targetY: 0, target: 0 }
    const start = performance.now()
    // Without this, every panel plays the same blob paths in lockstep.
    const offset = Math.random() * 1000
    let frame: number | null = null

    root.addEventListener('pointermove', (event) => {
      const rect = root.getBoundingClientRect()
      pointer.targetX = (event.clientX - rect.left - rect.width / 2) / rect.height
      pointer.targetY = -(event.clientY - rect.top - rect.height / 2) / rect.height
      pointer.target = 1
    })
    root.addEventListener('pointerleave', () => (pointer.target = 0))

    const draw = (now: number) => {
      pointer.x += (pointer.targetX - pointer.x) * 0.04
      pointer.y += (pointer.targetY - pointer.y) * 0.04
      pointer.z += (pointer.target - pointer.z) * 0.04
      gl.uniform1f(u.time, offset + (still ? 20 : ((now - start) / 1000) * speed))
      gl.uniform3f(u.pointer, pointer.x, pointer.y, pointer.z)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
    }
    const loop = (now: number) => {
      draw(now)
      frame = requestAnimationFrame(loop)
    }
    const play = () => {
      if (!still && !frame) frame = requestAnimationFrame(loop)
    }
    const pause = () => {
      if (frame) cancelAnimationFrame(frame)
      frame = null
    }
    const resize = () => {
      const scale = devicePixelRatio * RENDER_SCALE
      canvas.width = Math.max(1, Math.ceil(canvas.clientWidth * scale))
      canvas.height = Math.max(1, Math.ceil(canvas.clientHeight * scale))
      gl.viewport(0, 0, canvas.width, canvas.height)
      gl.uniform2f(u.resolution, canvas.width, canvas.height)
      draw(performance.now())
    }

    new ResizeObserver(resize).observe(canvas)
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : pause())).observe(canvas)
  }

  document.querySelectorAll<HTMLElement>('[data-lava]').forEach(mount)
</script>
