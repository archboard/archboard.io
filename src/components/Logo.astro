---
/** The Archboard "A" mark. Every product uses it, filled with that product's brand gradient. */
interface Props {
  gradient?: [string, string, string]
  class?: string
  label?: string
}

const { gradient = ['#ffb900', '#ff6900', '#ff2056'], class: className, label } = Astro.props
const id = `mark-${Math.random().toString(36).slice(2, 9)}`
---

<svg
  viewBox="0 0 226.59 226.59"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={gradient[0]}></stop>
      <stop offset="0.5" stop-color={gradient[1]}></stop>
      <stop offset="1" stop-color={gradient[2]}></stop>
    </linearGradient>
  </defs>
  <path
    fill={`url(#${id})`}
    d="M29.66,0h-13.66C7.2,0,0,7.2,0,16v194.59c0,8.84,7.16,16,16,16h42.39c6.79,0,12.84-4.28,15.09-10.69l2.24-6.35,52.8-150c.5-1.41-.55-2.89-2.04-2.89h-26.12c-1.36,0-2.57.86-3.02,2.14-15.14,43.01-30.28,86.02-45.42,129.03-.11.45-1.91,7.36-8.41,9.43-3.15,1-8.38,1.18-11.54-2.4-2.17-2.46-2.31-5.48-2.31-6.59V33.66c0-2.21,1.79-4,4-4h159.26c2.21,0,4,1.79,4,4v153.34c0,5.48-4.44,9.92-9.920,9.92h0c-4.85,0-9.17-3.06-10.78-7.63l-20.53-58.33c-.31-.87-1.12-1.450-2.04-1.45h-28.38c-.92,0-1.74.58-2.04,1.45l-4.71,13.38-4.2,11.94c-.5,1.41.55,2.89,2.04,2.89h16.29c.92,0,1.74.58,2.04,1.45l14.69,41.74,4.76,13.54c2.25,6.4,8.3,10.69,15.09,10.69h41.35c8.84,0,16-7.16,16-16V16c0-8.84-7.16-16-16-16H29.66Z"
  ></path>
</svg>
