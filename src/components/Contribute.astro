---
import Container from './Container.astro'
import { links, href } from '../data/apps'

const steps = [
  {
    title: 'Bring an idea.',
    body: "Something that bugs you, or something you wish it did. Describe it the way you'd tell a coworker. No tech words needed.",
    color: 'border-primary-500 text-primary-500',
  },
  {
    title: 'Build it.',
    body: 'Write the code yourself, or let an AI tool do the techy bits. Both are welcome. Not a coder? Paste the starter prompt below into the AI tool you already use and steer it: “yes”, “no”, “more like this”.',
    color: 'border-amber-400 text-amber-400',
  },
  {
    title: "Send it. We'll ship it.",
    body: 'Submit it on GitHub. A free account is all you need. We review every change and help polish it. Then it goes out in the next update.',
    color: 'border-rose-500 text-rose-400',
  },
]

const starterPrompt =
  `I'm not a developer, but I want to improve Tidal PTC, a free app for schools. Read its contributor guide at ${links.contributing}, explain things simply, build my idea with me, and walk me through submitting it as a pull request on GitHub. My idea: …`
---

<section id="contribute" aria-labelledby="contribute-title" class="border-y border-gray-800 bg-gray-950">
  <Container class="flex flex-col gap-14 py-25">
    <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-6">
      <div class="flex flex-col gap-5">
        <span class="eyebrow">06 / GET INVOLVED</span>
        <h2 id="contribute-title" class="headline max-w-[12ch] text-[clamp(48px,7vw,112px)]">
          This only works <em class="text-primary-500">with you.</em>
        </h2>
      </div>
      <div class="flex max-w-[44ch] flex-col items-start gap-5">
        <p class="text-xl/relaxed text-gray-300">
          Got an idea? Tell us. That's the whole job. Want to go further?{' '}
          <em class="font-display text-2xl text-white">You can build it,</em>{' '}
          with or without AI. We review every change before it ships.
        </p>
        <a href={href(links.newIssue)} class="btn-primary">Tell us your idea</a>
      </div>
    </div>

    <ol class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-10">
      {
        steps.map((step, i) => (
          <li class={`flex flex-col gap-3.5 border-t-2 pt-6 ${step.color}`}>
            <span class="font-display text-[88px] leading-[0.8]">{i + 1}</span>
            <h3 class="text-[26px] font-bold tracking-tight text-white">{step.title}</h3>
            <p class="text-base/relaxed text-gray-400">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="flex flex-wrap items-center gap-x-12 gap-y-6 rounded-3xl border border-gray-800 bg-black p-7">
      <div class="flex min-w-0 flex-[1_1_260px] flex-col gap-3">
        <span class="font-mono text-[13px] tracking-[0.06em] text-primary-500">BUILDING WITH AI?</span>
        <h3 class="font-display text-4xl leading-[1.05]">The starter prompt</h3>
        <p class="text-[15px]/relaxed text-gray-400">Copy it, paste it into your AI tool, add your idea. That's it.</p>
        <div class="flex flex-wrap gap-x-5 gap-y-1">
          <a href={href(links.contributing)} class="inline-flex min-h-11 items-center text-sm text-gray-400 no-underline hover:text-white">Writing the code yourself? Read the contributor guide</a>
        </div>
      </div>
      <div class="flex min-w-0 flex-[2_1_340px] flex-col gap-4.5">
        <div id="starter-prompt" class="rounded-2xl border border-dashed border-gray-600 bg-gray-900 p-4.5 font-mono text-[13px]/relaxed text-gray-200">{starterPrompt}</div>
        <button type="button" data-copy="#starter-prompt" class="btn-primary min-h-13 self-start text-base">
          <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
          <span data-copy-label>Copy starter prompt</span>
        </button>
      </div>
    </div>
  </Container>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector('[data-copy-label]')!
    const original = label.textContent
    button.addEventListener('click', async () => {
      const text = document.querySelector(button.dataset.copy!)?.textContent?.trim() ?? ''
      try {
        await navigator.clipboard.writeText(text)
        label.textContent = 'Copied!'
      } catch {
        label.textContent = 'Select the text to copy'
      }
      setTimeout(() => (label.textContent = original), 2000)
    })
  })
</script>
