---
import Container from './Container.astro'
import LavaPanel from './LavaPanel.astro'

const ring = 'NO SEATS · NO CONTRACTS · NO NONSENSE ·'
---

<section aria-labelledby="hero-title" class="px-4">
  <LavaPanel
    colors={['#ff2056', '#ffb900', '#ffb900', '#155dfc', '#8e51ff']}
    class="flex min-h-190 rounded-4xl bg-primary-500"
  >
    <Container class="flex w-full flex-col justify-between gap-12 pt-10 pb-[clamp(32px,5vw,64px)]">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <span class="inline-flex min-h-9 items-center gap-2 rounded-full bg-black px-3.5 font-mono text-[13px] tracking-[0.02em] text-white">
          <span class="size-2 rounded-full bg-amber-400"></span>Open source · Made for schools
        </span>

        <div class="relative size-44 shrink-0 animate-bob" aria-label="$0 forever" role="img">
          <svg viewBox="0 0 176 176" class="absolute inset-0 size-full animate-spin-slow" aria-hidden="true">
            <defs><path id="ring" d="M88,88 m-66,0 a66,66 0 1,1 132,0 a66,66 0 1,1 -132,0"></path></defs>
            <circle cx="88" cy="88" r="86" fill="#000"></circle>
            <text fill="#ff6900" class="font-mono text-[13px] tracking-[0.18em]"><textPath href="#ring">{ring}</textPath></text>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center" aria-hidden="true">
            <span class="font-display text-[52px] leading-none">$0</span>
            <span class="text-xs font-semibold tracking-[0.08em] text-amber-400 uppercase">forever*</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-8">
        <h1 id="hero-title" class="max-w-[12ch] font-display text-[clamp(60px,10.5vw,168px)] leading-[0.9] font-normal tracking-[-0.025em] text-black">
          Good apps. <em>Free.</em> Built together.
        </h1>
        <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
          <p class="max-w-130 text-xl/normal font-medium text-black">
            [One or two sentences: Archboard makes open-source apps for schools, and the community makes them better.]
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#apps" class="btn min-h-14 bg-black px-6.5 text-[17px] text-white hover:bg-gray-900">
              See the apps
              <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a href="#contribute" class="btn min-h-14 border-2 border-black px-6.5 text-[17px] text-black hover:bg-black/10">Help shape them</a>
          </div>
        </div>
      </div>
    </Container>
  </LavaPanel>
</section>
