---
import '../styles/global.css'
import { links } from '../data/apps'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Archboard — quality apps for schools, free',
  description = 'Archboard builds free, open-source apps for schools, and the community makes them better.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const home = Astro.site!.href

// Structured data so search engines know who runs the site. Only facts already on the page.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${home}#organization`,
      name: 'Archboard',
      url: home,
      logo: new URL('/favicon.svg', home).href,
      email: links.email,
      sameAs: [links.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: 'Archboard',
      url: home,
      publisher: { '@id': `${home}#organization` },
    },
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Archboard: Free, open-source apps for schools." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="overflow-x-hidden">
    <slot />
  </body>
</html>
